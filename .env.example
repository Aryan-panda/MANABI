# ==========================================
# MANABI — Environment Configuration Template
# ==========================================

# Application
APP_NAME=MANABI
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-strong-secret-key-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=manabi
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/manabi
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/manabi

# Cache & Ephemeral Workloads (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration
# Supported options: 'gemini', 'openai', 'ollama'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro

# Gemini API
GEMINI_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# External Ollama (No containerization; HTTP endpoint only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embedding Provider
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Academic Data Provider
# Supported options: 'mock', 'external'
ACADEMIC_DATA_PROVIDER=mock
EXTERNAL_COLLEGE_API_BASE_URL=
EXTERNAL_COLLEGE_API_KEY=

# CORS Settings (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]
